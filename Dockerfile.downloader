FROM python:3.12.12-slim-bookworm@sha256:2986c55feb36e6cae00fa1fefb454283e4b33f35e75ff8bdd123b134130be301
WORKDIR /app
COPY requirements-downloader.txt /app/requirements.txt
COPY scripts/check_dependencies.py /app/check_dependencies.py
RUN pip install --no-cache-dir --only-binary=:all: --no-deps -r /app/requirements.txt \
    && pip check \
    && python /app/check_dependencies.py /app/requirements.txt \
    && groupadd --gid 10001 inference \
    && useradd --uid 10001 --gid 10001 --create-home inference \
    && mkdir -p /models/model && chown -R 10001:10001 /models /app
COPY --chown=10001:10001 scripts/download_model.py /app/download_model.py
ENV HOME=/tmp \
    HF_HOME=/tmp/huggingface \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HUB_DISABLE_PROGRESS_BARS=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    HF_HUB_DISABLE_XET=1
USER 10001:10001
ENTRYPOINT ["python", "/app/download_model.py"]
